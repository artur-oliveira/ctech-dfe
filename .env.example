# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# DynamoDB
TABLE_PREFIX=dev
DYNAMODB_ENDPOINT=  # Leave empty for AWS, use http://localhost:8000 for local

# API Configuration
SECRET_KEY=your-secret-key-here
API_V1_STR=/v1.0

# S3
S3_BUCKET_CERTIFICATES=py-dfe-certificates

# Environment
ENVIRONMENT=dev
