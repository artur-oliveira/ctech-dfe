# ctech-dfe-api environment variables
# Copy to .env for local development

# Server
PORT=8080
ENVIRONMENT=dev

# AWS
AWS_REGION=us-east-1
TABLE_PREFIX=dev
S3_BUCKET_CERTIFICATES=dev-py-dfe-certificates
S3_BUCKET_DOCUMENTS=dev-py-dfe-documents
SEFAZ_FUNCTION_NAME=dev-py-dfe

# For local DynamoDB (LocalStack / DynamoDB Local)
# DYNAMODB_ENDPOINT=http://localhost:4566

# SQS
DFE_TOPIC_ARN=
DFE_RESULTS_QUEUE_URL=
DFE_DISTRIBUTION_QUEUE_URL=

# Auth — RS256 JWKS from ctech-account
CTECH_URL=https://accounts.aoctech.app
# CTECH_JWKS_URL is auto-derived from CTECH_URL if not set

# Cache — Redis/Valkey (optional; falls back to in-memory if unset)
# VALKEY_URL=redis://localhost:6379

# DANFE
MEUDANFE_API_KEY=
