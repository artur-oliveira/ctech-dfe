# API Configuration
# Empty = same-origin. `next dev` proxies /v1.0/* to DEV_API_ORIGIN, which is what
# CloudFront does in front of the ALB in deployed environments — so CORS never applies.
NEXT_PUBLIC_API_URL=
DEV_API_ORIGIN=http://localhost:8000

# next dev rewrites do not proxy the WebSocket upgrade — point it at the API directly.
NEXT_PUBLIC_WS_URL=http://localhost:8000

# OAuth (ctech-account)
NEXT_PUBLIC_CTECH_URL=http://localhost:8080
NEXT_PUBLIC_CTECH_CLIENT_URL=http://localhost:3001
NEXT_PUBLIC_CTECH_CLIENT_ID=dfe
